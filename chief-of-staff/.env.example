# ── Required ────────────────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by all agents (override per agent below if you like)
GEMINI_MODEL=gemini-2.5-flash
# CHESS_MODEL=gemini-2.5-pro
# ALEX_MODEL=gemini-2.5-pro
# RESEARCH_MODEL=gemini-2.5-flash

# ── You ─────────────────────────────────────────────────────
SENDER_NAME=Your Name
SENDER_EMAIL=you@yourcompany.com
USER_TITLE=CEO, Your Company
# Signature appended to every email. Use \n for new lines.
EMAIL_SIGNATURE=Best,\nYour Name\nCEO, Your Company\nLinkedIn: https://linkedin.com/in/you | Website: https://yourcompany.com

# ── Gmail (send email) ──────────────────────────────────────
# Run: python scripts/gmail_auth.py  (creates gmail_token.json)
# For cloud deploys, paste the printed value here instead:
# GMAIL_TOKEN_B64=
# Emails wait for your Send/Discard in the dashboard unless this is true
AUTO_SEND_EMAIL=false

# ── HubSpot (update CRM) ────────────────────────────────────
# HubSpot > Settings > Integrations > Private Apps > create app with scopes:
# crm.objects.contacts.read/write, crm.objects.companies.read/write
HUBSPOT_ACCESS_TOKEN=

# ── Email finding (optional, strongly recommended) ──────────
# https://hunter.io/api-keys. Without it Alex falls back to pattern guesses.
HUNTER_API_KEY=

# ── Server ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Set a password if you deploy this anywhere public
APP_PASSWORD=
